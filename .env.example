# 图嘟嘟服务端环境变量示例
#
# 复制成 .env 就能用：cp .env.example .env
# 服务启动时会自动读取当前目录下的 .env；真实环境变量优先级更高，不会被文件覆盖。
# 也可以用 TUDUDU_ENV_FILE=/etc/tududu.env 指定别的路径。
#
# 下面标「必填」的没有默认值，缺失会直接启动失败。

# ---------- 服务 ----------

# HTTP 监听地址
TUDUDU_LISTEN=0.0.0.0:8080

# 本地数据目录：上传的原图、缩略图、生成图都落在这里
TUDUDU_DATA_DIR=./data

# ---------- 数据库 ----------

# 必填。PostgreSQL 连接串，启动时自动跑迁移
TUDUDU_DATABASE_URL=postgres://tududu:密码@127.0.0.1:5432/tududu

# 连接池上限
TUDUDU_DB_MAX_CONNECTIONS=10

# ---------- 令牌 ----------

# 必填，至少 32 位。用于签发用户令牌，也用来派生渠道密钥的加密密钥。
# 生成方式：openssl rand -hex 32
# 换掉它会让所有已登录用户失效，也会让已加密的渠道密钥解不开，不要随便改。
TUDUDU_JWT_SECRET=

# 访问令牌有效期（秒），默认 15 分钟
TUDUDU_ACCESS_TTL=900

# 刷新令牌有效期（秒），默认 30 天
TUDUDU_REFRESH_TTL=2592000

# ---------- 管理后台 ----------

# 首次启动时如果没有管理员，用这组账号自动建一个，之后就忽略这两个变量。
# 建好之后请到后台改密码，并及时把这里清空。
TUDUDU_ADMIN_USERNAME=admin
TUDUDU_ADMIN_PASSWORD=

# 旧的单一令牌，保留作过渡。配置后仍可用 x-admin-token 调管理接口；
# 账号体系就绪后可以留空。
TUDUDU_ADMIN_TOKEN=

# ---------- 对外地址 ----------

# 拼接支付回调地址用，例如 https://api.tududu.top
# 不配置的话支付下单会失败，因为网关需要回调地址。
TUDUDU_PUBLIC_BASE_URL=https://api.tududu.top

# ---------- 存储与清理 ----------

# 单用户存储上限（字节），默认 2GB
TUDUDU_QUOTA_BYTES=2147483648

# 回收站保留天数，到期后原图与缩略图会被真正删掉
TUDUDU_TRASH_DAYS=30

# ---------- 跨域 ----------

# 允许的来源，逗号分隔。App 内的页面从 tauri://localhost 加载，默认已放行。
# 只部署网页版且前后端同源时可以留空。
TUDUDU_CORS_ORIGINS=https://tauri.localhost,http://tauri.localhost,tauri://localhost

# ---------- 日志 ----------

# 日志级别，语法同 RUST_LOG
TUDUDU_LOG=info
